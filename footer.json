enu a, .pkp_navigation_search a{color:#e6eef7 !important;}\n.pkp_navigation_primary a:hover, .pkp_navigation_user_wrapper a:hover, .pkp_site_nav_menu a:hover, .pkp_navigation_search a:hover{color:#C9A84C !important;}\n.pkp_navigation_primary{border:none !important;}\n/* Header — ixcham balandlik */\n.pkp_head_wrapper{padding-top:4px !important;padding-bottom:4px !important;}\n.pkp_site_name_wrapper{margin:0 !important;}\n/* Dropdown submenu — navy fon, o'qiladigan (avval oq fonda ochiq matn edi) */\n.pkp_navigation_primary li ul{background:#0D2B4E !important;border:1px solid rgba(201,168,76,.35) !important;box-shadow:0 6px 16px rgba(0,0,0,.25) !important;}\n.pkp_navigation_primary li ul a{color:#e6eef7 !important;}\n.pkp_navigation_primary li ul a:hover{color:#C9A84C !important;background:#1A3D5C !important;}\n/* Header title — nom + ISSN bitta qatorda (meros uslubi) */\n.pkp_site_name{position:static !important;width:auto !important;}\n.pkp_site_name a.is_img{display:flex !important;align-items:center;gap:16px;text-decoration:none;width:auto !important;}\n.pkp_site_name a.is_img img{width:54px !important;height:auto !important;flex:0 0 auto;}\n.ssu-headtitle{display:flex;flex-direction:row;align-items:baseline;gap:16px;flex-wrap:wrap;}\n.ssu-jname{color:#ffffff;font:700 20px/1.2 Arial,sans-serif;white-space:nowrap;}\n.ssu-issn{color:#C9A84C;font:700 14px/1.2 Arial,sans-serif;letter-spacing:1px;}\n@media (max-width:900px){.ssu-headtitle{flex-direction:column;align-items:flex-start;gap:2px;} .ssu-jname{font-size:15px;white-space:normal;} .ssu-issn{font-size:12px;} .pkp_site_name a.is_img img{width:46px !important;}}\n/* Submit-article button */\n.ssu-submit-block{margin-bottom:22px;}\n.ssu-submit-btn{display:block;background:#0D2B4E;color:#fff !important;text-align:center;padding:12px 14px;border-radius:7px;font:600 14px/1.3 Arial,sans-serif;text-decoration:none !important;box-shadow:0 2px 6px rgba(13,43,78,.25);transition:background .2s,color .2s;}\n.ssu-submit-btn:hover{background:#C9A84C;color:#0D2B4E !important;}\n/* Sidebar block titles */\n.pkp_structure_sidebar .pkp_block{margin-bottom:24px;}\n.pkp_structure_sidebar .pkp_block h2.title:not(.pkp_screen_reader){background:#1A3D5C;color:#fff;border-bottom:2px solid #C9A84C;font:700 12px/1.5 Arial,sans-serif;text-transform:uppercase;letter-spacing:.5px;padding:7px 12px;margin:0 0 12px;display:block;}\n.pkp_structure_sidebar .pkp_block .content a{color:#0D2B4E;}\n.pkp_structure_sidebar .pkp_block .content a:hover{color:#C9A84C;}\n/* Footer — kulrang fonni yo'qotish, to'liq navy */\n.pkp_structure_footer_wrapper{background:#0D2B4E !important;}\n.pkp_structure_footer{background:#0D2B4E !important;}\n.pkp_footer_content{padding:0 !important;}\n.pkp_structure_footer div[style*=\"0D2B4E\"]{margin-top:0 !important;margin-bottom:0 !important;}\n/* OJS / PKP kreditini yashirish */\na[href*=\"pkp.sfu.ca\"], a[href*=\"openjournalsystems\"], .pkp_brand_footer{display:none !important;}\n/* ===== Menyu bir qatorda (desktop): chapda logo+nom, o'ngda menyu ===== */\n@media (min-width:901px){\n  .pkp_head_wrapper{display:flex !important;align-items:center;justify-content:space-between;flex-wrap:nowrap;gap:24px;padding:6px 0 !important;}\n  .pkp_site_name_wrapper{width:auto !important;flex:0 0 auto;margin:0 !important;}\n  .pkp_site_nav_menu{width:auto !important;flex:0 1 auto;display:flex !important;align-items:center;justify-content:flex-end;gap:18px;position:static !important;margin-left:auto;}\n  .pkp_navigation_user_wrapper{position:static !important;width:auto !important;max-width:none !important;flex:0 0 auto !important;top:auto !important;right:auto !important;left:auto !important;order:2;}\n  .pkp_navigation_user_wrapper ul, #navigationUser{width:auto !important;float:none !important;margin:0 !important;}\n  .pkp_navigation_primary_row{display:flex !important;flex-wrap:nowrap !important;align-items:center;gap:6px;margin:0 !important;width:auto !important;flex:0 0 auto;}\n  .pkp_navigation_primary_wrapper{width:auto !important;}\n  .pkp_navigation_primary{display:flex !important;flex-wrap:nowrap !important;margin:0 !important;width:auto !important;}\n  .pkp_navigation_primary > li{float:none !important;white-space:nowrap;list-style:none;}\n  .pkp_navigation_primary > li > a{padding-top:6px !important;padding-bottom:6px !important;}\n  .pkp_navigation_search_wrapper{float:none !important;white-space:nowrap;}\n  .pkp_navigation_user{display:flex !important;flex-wrap:nowrap !important;gap:10px;margin:0 !important;}\n  .pkp_navigation_user > li{float:none !important;white-space:nowrap;list-style:none;}\n  .ssu-jname{font-size:18px;}\n}\n</style>\n<script>(function(){try{var a=document.querySelector(\".pkp_site_name a.is_img\");if(a&&!a.querySelector(\".ssu-headtitle\")){var d=document.createElement(\"div\");d.className=\"ssu-headtitle\";d.innerHTML=\"<span class=\\\"ssu-jname\\\">SOCIAL SCIENCES IN UZBEKISTAN</span><span class=\\\"ssu-issn\\\">ISSN: 2181-5402</span>\";a.appendChild(d);}var sb=document.querySelector(\".pkp_structure_sidebar\");if(sb&&!sb.querySelector(\".ssu-submit-block\")){var b=document.createElement(\"div\");b.className=\"ssu-submit-block pkp_block\";b.innerHTML=\"<a class=\\\"ssu-submit-btn\\\" href=\\\"/index.php/ssu/about/submissions\\\">Make a Submission</a>\";sb.insertBefore(b, sb.firstChild);}document.querySelectorAll(\".pkp_structure_footer a, footer a\").forEach(function(x){var h=(x.href||\"\")+\" \"+x.textContent;if(/pkp\\.sfu|openjournalsystems|open journal systems|public knowledge/i.test(h)){var w=x.closest(\"li\")||x.closest(\"div\")||x;w.style.display=\"none\";}});}catch(e){}})();</script>"}